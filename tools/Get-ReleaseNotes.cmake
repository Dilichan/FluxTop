# Extract release-specific Markdown using CMake only (UTF-8; no encoding surprises).
cmake_minimum_required(VERSION 3.24)
foreach(required ROOT TAG OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing -D${required}")
    endif()
endforeach()
if(NOT TAG MATCHES "^v[0-9]+\\.[0-9]+\\.[0-9]+(-preview\\.[0-9]+)?$")
    message(FATAL_ERROR "Unsupported release tag: ${TAG}")
endif()
string(SUBSTRING "${TAG}" 1 -1 version)
if(TAG STREQUAL "v0.2.0-preview.1")
    set(version "0.2.0 Preview")
endif()
get_filename_component(root "${ROOT}" ABSOLUTE)
get_filename_component(output "${OUTPUT}" ABSOLUTE BASE_DIR "${root}")
file(READ "${root}/docs/RELEASE_NOTES.md" content)
string(REPLACE "\r\n" "\n" content "${content}")
set(heading "## FluxTop ${version}")
string(FIND "${content}" "${heading}" begin)
if(begin EQUAL -1)
    message(FATAL_ERROR "Release notes heading is missing: ${heading}")
endif()
if(begin GREATER 0)
    math(EXPR previous "${begin}-1")
    string(SUBSTRING "${content}" ${previous} 1 previous_char)
    if(NOT previous_char STREQUAL "\n")
        message(FATAL_ERROR "Release heading did not start at the beginning of a line")
    endif()
endif()
string(SUBSTRING "${content}" ${begin} -1 section)
string(LENGTH "${heading}" heading_len)
string(SUBSTRING "${section}" ${heading_len} 1 next_char)
if(NOT next_char MATCHES "^[ \t\n\r]$" AND NOT next_char STREQUAL "—")
    message(FATAL_ERROR "Release heading has a conflicting version suffix: ${heading}")
endif()
string(FIND "${section}" "\n## FluxTop " next)
if(NOT next EQUAL -1)
    string(SUBSTRING "${section}" 0 ${next} section)
endif()
# Ignore documentation-only publication checklist after this heading.
string(FIND "${section}" "\n### Проверка перед публикацией" checklist)
if(NOT checklist EQUAL -1)
    string(SUBSTRING "${section}" 0 ${checklist} section)
endif()
string(STRIP "${section}" section)
if(section STREQUAL "")
    message(FATAL_ERROR "Release notes are empty")
endif()
get_filename_component(directory "${output}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(WRITE "${output}" "${section}\n")
message(STATUS "Release notes created: ${output}")