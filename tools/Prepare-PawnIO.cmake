cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/PawnIO-Pin.cmake")
if(NOT DEFINED PAWNIO_FILE)
    set(PAWNIO_FILE "${CMAKE_CURRENT_LIST_DIR}/../assets/pawnio/PawnIO_setup.exe")
endif()
get_filename_component(destination "${PAWNIO_FILE}" ABSOLUTE)
if(EXISTS "${destination}")
    file(SHA256 "${destination}" digest)
    if(NOT digest STREQUAL FLUXTOP_PAWNIO_SHA256)
        message(FATAL_ERROR "Existing PawnIO installer does not match the pinned SHA-256: ${destination}")
    endif()
    message(STATUS "Verified official PawnIO ${FLUXTOP_PAWNIO_VERSION}: ${destination}")
    return()
endif()

get_filename_component(directory "${destination}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(temporary "${destination}.${suffix}.download")
file(DOWNLOAD
    "https://github.com/namazso/PawnIO.Setup/releases/download/${FLUXTOP_PAWNIO_VERSION}/PawnIO_setup.exe"
    "${temporary}" TLS_VERIFY ON STATUS status TIMEOUT 120 INACTIVITY_TIMEOUT 30)
list(GET status 0 code)
if(NOT code EQUAL 0)
    file(REMOVE "${temporary}")
    message(FATAL_ERROR "Cannot provision the official PawnIO build input: ${status}")
endif()
file(SHA256 "${temporary}" digest)
if(NOT digest STREQUAL FLUXTOP_PAWNIO_SHA256)
    file(REMOVE "${temporary}")
    message(FATAL_ERROR "Downloaded PawnIO installer does not match the pinned SHA-256")
endif()
file(RENAME "${temporary}" "${destination}" NO_REPLACE RESULT result)
if(NOT result STREQUAL "0")
    file(REMOVE "${temporary}")
    if(NOT EXISTS "${destination}")
        message(FATAL_ERROR "Cannot publish the verified PawnIO installer: ${result}")
    endif()
    file(SHA256 "${destination}" digest)
    if(NOT digest STREQUAL FLUXTOP_PAWNIO_SHA256)
        message(FATAL_ERROR "Concurrent PawnIO installer does not match the pinned SHA-256")
    endif()
endif()
message(STATUS "Verified official PawnIO ${FLUXTOP_PAWNIO_VERSION}: ${destination}")
