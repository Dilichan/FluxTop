file(TO_CMAKE_PATH "${SOURCE_ROOT}" SOURCE_ROOT)
file(TO_CMAKE_PATH "${BINARY_ROOT}" BINARY_ROOT)
string(TIMESTAMP stamp "%Y%m%d-%H%M%S")
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef suffix)
set(fixture "${BINARY_ROOT}/header-deps-${stamp}-${suffix}")
file(MAKE_DIRECTORY "${fixture}/src")
set(environment "")
set(configure_environment "")
if(FIX_ENVIRONMENT)
    set(environment "include(\"${SOURCE_ROOT}/cmake/MsvcNinjaDependencies.cmake\")")
    set(configure_environment "fluxtop_configure_compiler_environment()")
endif()
file(WRITE "${fixture}/src/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)\n${environment}\nproject(HeaderABI LANGUAGES CXX)\n${configure_environment}\nadd_executable(header_abi main.cpp provider.cpp)\ntarget_compile_features(header_abi PRIVATE cxx_std_20)\ntarget_compile_options(header_abi PRIVATE /GS /O2 /EHsc)\n")
file(WRITE "${fixture}/src/state.hpp" "#pragma once\nstruct State { char bytes[16]; };\nvoid initialize(State& value);\n")
file(WRITE "${fixture}/src/provider.cpp" "#include \"state.hpp\"\n#include <cstring>\nvoid initialize(State& value) { std::memset(value.bytes, 0x54, sizeof(value.bytes)); }\n")
file(WRITE "${fixture}/src/main.cpp" "#include \"state.hpp\"\n#include <cstdlib>\nint main(int argc,char** argv) { State value{}; initialize(value); return argc==2 && sizeof(value.bytes)==std::strtoul(argv[1],nullptr,10) && value.bytes[0]==0x54 ? 0 : 3; }\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}/src" -B "${fixture}/build" -G Ninja "-DCMAKE_CXX_COMPILER=${COMPILER}" "-DCMAKE_MAKE_PROGRAM=${NINJA}" -DCMAKE_BUILD_TYPE=Release RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Configure fixture failed: ${out}\n${err}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${fixture}/build" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Initial build failed: ${out}\n${err}")
endif()
execute_process(COMMAND "${fixture}/build/header_abi.exe" 16 RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Initial ABI fixture failed: ${code}")
endif()
file(WRITE "${fixture}/src/state.hpp" "#pragma once\nstruct State { char bytes[256]; };\nvoid initialize(State& value);\n")
# Recompile the writer explicitly; the unchanged caller MUST rebuild because
# of its header dependency or its old stack allocation will be overwritten.
file(APPEND "${fixture}/src/provider.cpp" "// new writer version\n")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${fixture}/build" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Incremental ABI build failed: ${out}\n${err}")
endif()
execute_process(COMMAND "${fixture}/build/header_abi.exe" 256 RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Header dependency/ABI mismatch, child result=${code}; evidence=${fixture}\n${out}\n${err}")
endif()
message(STATUS "Header ABI dependency fixture passed: ${fixture}")
