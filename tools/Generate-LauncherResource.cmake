foreach(required INPUT OUTPUT ICON VERSION RELEASE_TAG TEMPLATE UNINSTALLER)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(NOT EXISTS "${UNINSTALLER}")
    message(FATAL_ERROR "Missing native uninstaller executable: ${UNINSTALLER}")
endif()
file(SHA256 "${INPUT}" payload_hash)
string(REPLACE "." "," version_numbers "${VERSION}")
configure_file("${TEMPLATE}" "${OUTPUT}" @ONLY)
