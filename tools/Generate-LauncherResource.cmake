foreach(required INPUT OUTPUT ICON VERSION RELEASE_TAG TEMPLATE UNINSTALLER)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(NOT EXISTS "${UNINSTALLER}")
    message(FATAL_ERROR "Missing native uninstaller executable: ${UNINSTALLER}")
endif()
set(intel_resource_line "")
set(intel_source "${CMAKE_CURRENT_LIST_DIR}/../assets/pawnio/IntelMSR.bin")
if(EXISTS "${intel_source}")
    file(TO_CMAKE_PATH "${intel_source}" intel_path)
    set(intel_resource_line "206 RCDATA \"${intel_path}\"")
endif()
set(pawnio_source "${CMAKE_CURRENT_LIST_DIR}/../assets/pawnio/PawnIO_setup.exe")
if(NOT EXISTS "${pawnio_source}")
    message(FATAL_ERROR "Missing offline PawnIO installer at ${pawnio_source}")
endif()
file(SHA256 "${pawnio_source}" pawnio_digest)
if(NOT pawnio_digest STREQUAL "1f519a22e47187f70a1379a48ca604981c4fcf694f4e65b734aaa74a9fba3032")
    message(FATAL_ERROR "Unrecognized PawnIO installer: pinned SHA-256 mismatch")
endif()
file(TO_CMAKE_PATH "${pawnio_source}" pawnio_path)
set(pawnio_resource_line "207 RCDATA \"${pawnio_path}\"")
file(SHA256 "${INPUT}" payload_hash)
string(REPLACE "." "," version_numbers "${VERSION}")
configure_file("${TEMPLATE}" "${OUTPUT}" @ONLY)
