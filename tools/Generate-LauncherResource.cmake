foreach(required INPUT OUTPUT ICON VERSION RELEASE_TAG TEMPLATE UNINSTALLER)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(NOT EXISTS "${UNINSTALLER}")
    message(FATAL_ERROR "Missing native uninstaller executable: ${UNINSTALLER}")
endif()
function(cpu_module output id filename expected)
    set(path "${CMAKE_CURRENT_LIST_DIR}/../assets/pawnio/${filename}")
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Unrecognized PawnIO CPU module ${filename}: pinned SHA-256 mismatch")
    endif()
    file(TO_CMAKE_PATH "${path}" path)
    set(${output} "${id} RCDATA \"${path}\"" PARENT_SCOPE)
endfunction()
cpu_module(intel_resource_line 206 IntelMSR.bin d6ed85d65ab17a22f813ef98207d6d537155ee2ded5976a21cb48413c9b92e5f)
cpu_module(amd_resource_line 208 AMDFamily17.bin dae74615761b78bdf064dfb3e136252ddcc6fc727d88f14738d0e5800d427a91)
include("${CMAKE_CURRENT_LIST_DIR}/PawnIO-Pin.cmake")
set(pawnio_source "${CMAKE_CURRENT_LIST_DIR}/../assets/pawnio/PawnIO_setup.exe")
if(NOT EXISTS "${pawnio_source}")
    message(FATAL_ERROR "Missing offline PawnIO installer at ${pawnio_source}. Run cmake -P tools/Prepare-PawnIO.cmake before building.")
endif()
file(SHA256 "${pawnio_source}" pawnio_digest)
if(NOT pawnio_digest STREQUAL FLUXTOP_PAWNIO_SHA256)
    message(FATAL_ERROR "Unrecognized PawnIO installer: pinned SHA-256 mismatch")
endif()
file(TO_CMAKE_PATH "${pawnio_source}" pawnio_path)
set(pawnio_resource_line "207 RCDATA \"${pawnio_path}\"")
file(SHA256 "${INPUT}" payload_hash)
string(REPLACE "." "," version_numbers "${VERSION}")
configure_file("${TEMPLATE}" "${OUTPUT}" @ONLY)
