# Native CMake release package: no PowerShell or Python dependencies.
cmake_minimum_required(VERSION 3.24)
foreach(required BUILD_DIRECTORY OUTPUT_DIR CONFIG)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing -D${required}")
    endif()
endforeach()
if(NOT DEFINED ROOT OR "${ROOT}" STREQUAL "")
    get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
else()
    get_filename_component(root "${ROOT}" ABSOLUTE)
endif()
get_filename_component(build "${BUILD_DIRECTORY}" ABSOLUTE BASE_DIR "${root}")
get_filename_component(out "${OUTPUT_DIR}" ABSOLUTE BASE_DIR "${root}")
set(exe "${build}/package/${CONFIG}/FluxTop.exe")
set(license "${root}/LICENSE")
if(NOT EXISTS "${exe}" OR NOT EXISTS "${license}")
    message(FATAL_ERROR "Release inputs not found; build the Release configuration first: ${exe}")
endif()
file(MAKE_DIRECTORY "${out}")
file(COPY_FILE "${exe}" "${out}/FluxTop.exe")
file(COPY_FILE "${license}" "${out}/LICENSE.txt")
file(SHA256 "${out}/FluxTop.exe" exe_sha)
file(SHA256 "${out}/LICENSE.txt" license_sha)
file(WRITE "${out}/SHA256SUMS.txt" "${exe_sha}  FluxTop.exe\n${license_sha}  LICENSE.txt\n")
message(STATUS "Packaged: ${out}/FluxTop.exe")
message(STATUS "SHA256: ${exe_sha}")